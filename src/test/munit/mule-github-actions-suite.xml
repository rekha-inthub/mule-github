	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="mule-github-actions-suite.xml" />
	<munit:test name="mule-github-actionsFlow-test" doc:id="4bd7621b-0f5f-4a88-b98c-1581d5b01f4c" >
		<munit:behavior >
			<munit:set-event doc:name="Set Input" doc:id="d813308c-fdcd-4ca2-9e7a-172216958826" >
				<munit:payload value="#[output application/json --- readUrl('classpath://mulegithubactionsFlowtest\set-event_payload1.dwl')]" encoding="UTF-8" mediaType="application/json" />
				<munit:attributes value="#[readUrl('classpath://mulegithubactionsFlowtest\set-event_attributes1.dwl')]" />
			</munit:set-event>
		</munit:behavior>
		<munit:execution >
			<flow-ref doc:name="Flow-ref to mule-github-actionsFlow" doc:id="df323c70-c48e-4f22-ab29-b7f93c190c72" name="mule-github-actionsFlow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert doc:name="Assert payload" doc:id="66711aa7-634a-4a18-a8c1-945d48034542" message="The payload does not match">
				<munit-tools:that ><![CDATA[#[%dw 2.0
import mulegithubactionsFlowtest::assert_expression_payload1
---
assert_expression_payload1::main({payload: payload, attributes: attributes, vars: vars})]]]></munit-tools:that>
			</munit-tools:assert>
		</munit:validation>
	</munit:test>


</mule>
